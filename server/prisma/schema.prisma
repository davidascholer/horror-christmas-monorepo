// Prisma schema for Horror Christmas Knowledge Graph
// Based on Design Document Section 5: Data Models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CollectionType {
  CHARACTER
  THEME
  BEGINNER
  GIFT
  SEASONAL_CHALLENGE
  TRADITION
}

enum MediaType {
  FILM
  TELEVISION_SPECIAL
  TELEVISION_EPISODE
}

// Core Entity Models

model Collection {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  type        CollectionType
  status      ContentStatus  @default(DRAFT)
  
  // Required editorial content
  introduction String
  curatorNotes String
  
  // Optional editorial content
  summary      String?
  
  // Hero image
  heroImage    String?
  heroImageAlt String?
  
  // SEO metadata
  seoTitle       String?
  seoDescription String?
  
  // Homepage features
  featured      Boolean @default(false)
  seasonal      Boolean @default(false)
  sortOrder     Int?
  
  // Publishing
  publishedAt DateTime?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relationships (defined in join models below)
  movies     CollectionMovie[]
  characters CollectionCharacter[]
  products   CollectionProduct[]
  franchises CollectionFranchise[]
  tags       CollectionTag[]
  
  // Related collections (outbound)
  relatedCollections CollectionRelated[] @relation("SourceCollection")
  // Related collections (inbound)
  relatedBy          CollectionRelated[] @relation("TargetCollection")
  
  @@index([status])
  @@index([featured])
  @@index([seasonal])
  @@index([type])
  @@index([slug])
}

model Movie {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  mediaType MediaType     @default(FILM)
  status    ContentStatus @default(DRAFT)
  
  // Optional content
  synopsis      String?
  originalTitle String?
  releaseYear   Int?
  releaseDate   DateTime?
  runtime       Int? // in minutes
  
  // Media assets
  poster    String?
  hero      String?
  trailerUrl String?
  
  // SEO metadata
  seoTitle       String?
  seoDescription String?
  
  // Features
  featured Boolean @default(false)
  
  // Publishing
  publishedAt DateTime?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Optional franchise relationship
  franchiseId String?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  
  // Relationships (defined in join models below)
  collections      CollectionMovie[]
  characters       MovieCharacter[]
  tags             MovieTag[]
  watchlistMovies  WatchlistMovie[]
  
  @@index([status])
  @@index([featured])
  @@index([franchiseId])
  @@index([slug])
  @@index([releaseYear])
}

model Character {
  id     String        @id @default(cuid())
  slug   String        @unique
  name   String
  status ContentStatus @default(DRAFT)
  
  // Optional content
  summary   String?
  biography String?
  origin    String?
  
  // Media assets
  image String?
  
  // SEO metadata
  seoTitle       String?
  seoDescription String?
  
  // Features
  featured Boolean @default(false)
  
  // Publishing
  publishedAt DateTime?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Optional franchise relationship
  franchiseId String?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  
  // Relationships (defined in join models below)
  collections CollectionCharacter[]
  movies      MovieCharacter[]
  products    ProductCharacter[]
  tags        CharacterTag[]
  
  @@index([status])
  @@index([featured])
  @@index([franchiseId])
  @@index([slug])
}

model Product {
  id       String        @id @default(cuid())
  slug     String        @unique
  name     String
  status   ContentStatus @default(DRAFT)
  
  // Optional content
  description String?
  category    String?
  
  // Media assets
  image    String?
  imageAlt String?
  
  // Fixed-precision price with currency
  price    Decimal? @db.Decimal(10, 2)
  currency String?  @db.Char(3)
  
  // SEO metadata
  seoTitle       String?
  seoDescription String?
  
  // Features
  featured Boolean @default(false)
  
  // Publishing
  publishedAt DateTime?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Optional franchise relationship
  franchiseId String?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  
  // Relationships (defined in join models below)
  collections    CollectionProduct[]
  characters     ProductCharacter[]
  tags           ProductTag[]
  affiliateLinks AffiliateLink[]
  
  @@index([status])
  @@index([featured])
  @@index([franchiseId])
  @@index([slug])
  @@index([category])
}

model Franchise {
  id   String @id @default(cuid())
  slug String @unique
  name String
  
  // Optional content
  description String?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relationships
  movies      Movie[]
  characters  Character[]
  products    Product[]
  collections CollectionFranchise[]
  
  @@index([slug])
}

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String
  
  // Optional content
  description String?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relationships
  collections CollectionTag[]
  movies      MovieTag[]
  characters  CharacterTag[]
  products    ProductTag[]
  
  @@index([slug])
}

model AffiliateLink {
  id       String @id @default(cuid())
  provider String
  url      String
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Product relationship
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([productId])
}

model Watchlist {
  id         String   @id @default(cuid())
  shareToken String   @unique
  title      String?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relationships
  movies WatchlistMovie[]
  
  @@index([shareToken])
}

model WatchlistMovie {
  // Composite primary key
  watchlistId String
  movieId     String
  
  // Order and timestamps
  sortOrder   Int
  addedAt     DateTime  @default(now())
  completedAt DateTime?
  
  // Relationships
  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  movie     Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  
  @@id([watchlistId, movieId])
  @@unique([watchlistId, sortOrder])
  @@index([watchlistId])
  @@index([movieId])
}

// Join Models for Many-to-Many Relationships

model CollectionMovie {
  collectionId String
  movieId      String
  
  // Relationship data
  sortOrder   Int
  curatorNote String?
  
  // Relationships
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  movie      Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  
  @@id([collectionId, movieId])
  @@unique([collectionId, sortOrder])
  @@index([collectionId])
  @@index([movieId])
}

model CollectionCharacter {
  collectionId String
  characterId  String
  
  // Relationship data
  sortOrder   Int
  curatorNote String?
  
  // Relationships
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  character  Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  
  @@id([collectionId, characterId])
  @@unique([collectionId, sortOrder])
  @@index([collectionId])
  @@index([characterId])
}

model CollectionProduct {
  collectionId String
  productId    String
  
  // Relationship data
  sortOrder   Int
  curatorNote String?
  
  // Relationships
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@id([collectionId, productId])
  @@unique([collectionId, sortOrder])
  @@index([collectionId])
  @@index([productId])
}

model CollectionFranchise {
  collectionId String
  franchiseId  String
  
  // Relationship data
  sortOrder Int
  
  // Relationships
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  franchise  Franchise  @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  
  @@id([collectionId, franchiseId])
  @@unique([collectionId, sortOrder])
  @@index([collectionId])
  @@index([franchiseId])
}

model CollectionTag {
  collectionId String
  tagId        String
  
  // Relationships
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([collectionId, tagId])
  @@index([collectionId])
  @@index([tagId])
}

model MovieCharacter {
  movieId     String
  characterId String
  
  // Relationship data
  role      String?
  sortOrder Int
  
  // Relationships
  movie     Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  
  @@id([movieId, characterId])
  @@unique([movieId, sortOrder])
  @@index([movieId])
  @@index([characterId])
}

model MovieTag {
  movieId String
  tagId   String
  
  // Relationships
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([movieId, tagId])
  @@index([movieId])
  @@index([tagId])
}

model CharacterTag {
  characterId String
  tagId       String
  
  // Relationships
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([characterId, tagId])
  @@index([characterId])
  @@index([tagId])
}

model ProductTag {
  productId String
  tagId     String
  
  // Relationships
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([productId, tagId])
  @@index([productId])
  @@index([tagId])
}

model ProductCharacter {
  productId   String
  characterId String
  
  // Relationship data
  sortOrder Int
  
  // Relationships
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  
  @@id([productId, characterId])
  @@unique([productId, sortOrder])
  @@index([productId])
  @@index([characterId])
}

model CollectionRelated {
  sourceCollectionId String
  targetCollectionId String
  
  // Relationship data (directional)
  sortOrder Int
  
  // Relationships
  sourceCollection Collection @relation("SourceCollection", fields: [sourceCollectionId], references: [id], onDelete: Cascade)
  targetCollection Collection @relation("TargetCollection", fields: [targetCollectionId], references: [id], onDelete: Cascade)
  
  @@id([sourceCollectionId, targetCollectionId])
  @@unique([sourceCollectionId, sortOrder])
  @@index([sourceCollectionId])
  @@index([targetCollectionId])
}
